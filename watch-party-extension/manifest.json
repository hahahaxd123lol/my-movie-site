{
  "manifest_version": 3,
  "name": "Flix2Watch Watch Party Controls",
  "version": "0.1.0",
  "description": "Synchronize play, pause, and seeking for the Flix2Watch API player in a Watch Party room.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://flix2watch-watch-party-api.onrender.com/*",
    "https://player.flix2watch.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Flix2Watch Watch Party",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://player.flix2watch.com/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
