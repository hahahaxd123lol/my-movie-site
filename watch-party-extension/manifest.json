{
  "manifest_version": 3,
  "name": "Flix2Watch Watch Party Controls",
  "version": "0.2.0",
  "description": "Experimental Watch Party play, pause, and seek bridge for the isolated Flix2Watch Render preview.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://flix2watch-watch-party-api.onrender.com/*",
    "https://flix2watch-watch-party-preview.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Flix2Watch Watch Party",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flix2watch-watch-party-preview.onrender.com/watch/*"
      ],
      "js": [
        "watch-page.js"
      ],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ]
}