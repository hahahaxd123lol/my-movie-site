@keyframes f2w-v146-spin{to{transform:rotate(360deg)}}
#f2w-v146-player-spinner,.f2w-v146-spin{animation:f2w-v146-spin .72s linear infinite!important;transform-origin:center}
#f2w-v146-announcement{position:fixed;left:50%;top:14px;transform:translateX(-50%);z-index:100200;width:min(920px,calc(100% - 28px));display:none;align-items:center;gap:10px;padding:11px 14px;border:1px solid rgba(229,9,20,.55);border-radius:13px;background:rgba(7,14,24,.97);box-shadow:0 14px 44px rgba(0,0,0,.45);color:#f8fafc;font:700 13px/1.4 Inter,system-ui,sans-serif;backdrop-filter:blur(12px)}
#f2w-v146-announcement.show{display:flex}#f2w-v146-announcement strong{color:#ff2633;white-space:nowrap}#f2w-v146-announcement span{flex:1;min-width:0}#f2w-v146-announcement button{border:0;background:transparent;color:#9fb0c4;font-size:18px;cursor:pointer}
#f2w-v146-enforcement{position:fixed;inset:0;z-index:2147483647;display:none;place-items:center;padding:22px;background:#02050a;color:#fff;font-family:Inter,system-ui,sans-serif}#f2w-v146-enforcement.show{display:grid}#f2w-v146-enforcement .box{width:min(560px,100%);padding:34px;border:1px solid #7f1620;border-radius:22px;background:linear-gradient(145deg,#15070a,#07111d);box-shadow:0 30px 90px rgba(0,0,0,.7);text-align:center}#f2w-v146-enforcement .icon{width:70px;height:70px;margin:auto;display:grid;place-items:center;border:1px solid #e50914;border-radius:20px;color:#ff2633;font-size:28px}#f2w-v146-enforcement h1{margin:20px 0 8px;font-size:28px}#f2w-v146-enforcement p{margin:0;color:#9fb0c4;line-height:1.65}
